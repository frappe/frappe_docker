# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md
#
# ПРОД-КОНФИГ для сервера. На сервере копируется в .env рядом с compose.yaml.
# Строки, помеченные <<< ЗАПОЛНИТЬ, надо править руками перед первым запуском.

# ---------------------------------------------------------------------------
# Набор compose-файлов. Без этой переменной docker compose увидит только
# базовый compose.yaml и снесёт db/redis/proxy.
# ---------------------------------------------------------------------------
# Порядок значим: compose.platform.yaml обязан идти ПОСЛЕ compose.migrator.yaml,
# иначе у migrator останется linux/amd64.
COMPOSE_FILE=compose.yaml:overrides/compose.mariadb.yaml:overrides/compose.redis.yaml:overrides/compose.https.yaml:overrides/compose.migrator.yaml:habibi/overrides/compose.bindmounts.yaml:habibi/overrides/compose.platform.yaml

# Архитектура хоста (оверрайд compose.platform.yaml). На Oracle Ampere и прочих
# ARM — linux/arm64, на обычных x86-серверах — linux/amd64. Должна совпадать
# с той, под которую собран образ: docker откажется запускать чужую.
PLATFORM=linux/arm64

# ---------------------------------------------------------------------------
# Раскладка данных на диске (оверрайд compose.bindmounts.yaml).
# Путь абсолютный. Каталоги sites/logs/mariadb/backups создать и выдать права
# ДО первого up -d — см. шапку compose.bindmounts.yaml.
# ---------------------------------------------------------------------------
DATA_ROOT=/u01/frappe

# Имя сайта. Должно совпадать с доменом из SITES_RULE, потому что
# FRAPPE_SITE_NAME_HEADER пустой и nginx резолвит сайт по Host запроса.
SITE_NAME=erp.ayntayba.com

# ---------------------------------------------------------------------------
# Образ
# ---------------------------------------------------------------------------
ERPNEXT_VERSION=v16.30.0

# Вариант А (без registry): образ собирается на сервере как habibi:16.
CUSTOM_IMAGE=habibi
CUSTOM_TAG=16
PULL_POLICY=never

# Вариант Б (через GHCR): раскомментировать и закомментировать вариант А.
#CUSTOM_IMAGE=ghcr.io/dhi-partners/habibi
#CUSTOM_TAG=16
#PULL_POLICY=always

RESTART_POLICY=unless-stopped

# ---------------------------------------------------------------------------
# База данных
# ---------------------------------------------------------------------------
# <<< ЗАПОЛНИТЬ: root-пароль MariaDB. Сгенерировать: openssl rand -base64 32
# Менять ПОСЛЕ создания сайта нельзя — пароль уйдёт в site_config.json.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Only if you use docker secrets for the db password
DB_PASSWORD_SECRETS_FILE=

# Only if you use external database (пусто = контейнер db из compose.mariadb.yaml)
DB_HOST=
DB_PORT=

# Only if you use external Redis (пусто = контейнеры из compose.redis.yaml)
REDIS_CACHE=
REDIS_QUEUE=

# ---------------------------------------------------------------------------
# Gunicorn
# ---------------------------------------------------------------------------
GUNICORN_THREADS=4

# (2 x vCPU) + 1. Каждый воркер ~400 МБ — сверяйте с памятью сервера.
GUNICORN_WORKERS=9

GUNICORN_TIMEOUT=120

# ---------------------------------------------------------------------------
# Домен и TLS (оверрайд compose.https.yaml)
# ---------------------------------------------------------------------------
# A-запись должна указывать на сервер ДО первого up -d, иначе Traefik закэширует
# неудачный ACME-запрос в томе cert-data.
# Несколько доменов: Host(`erp.ayntayba.com`) || Host(`www.ayntayba.com`)
SITES_RULE=Host(`erp.ayntayba.com`)

# <<< ЗАПОЛНИТЬ: реальный ящик, Let's Encrypt шлёт туда предупреждения об истечении
LETSENCRYPT_EMAIL=mail@example.com

# ---------------------------------------------------------------------------
# nginx внутри контейнера frontend
# ---------------------------------------------------------------------------
# Пусто = $host: сайт резолвится по домену из запроса.
# Требует, чтобы имя сайта в bench new-site совпадало с доменом из SITES_RULE.
FRAPPE_SITE_NAME_HEADER=

# Traefik слушает 80 — это обязательно для http-01 challenge Let's Encrypt.
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# Traefik стоит перед nginx, его IP — из docker-подсети, а не 127.0.0.1.
# Без этого в логах и в Frappe все клиенты будут с одним адресом.
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# ---------------------------------------------------------------------------
# Не используется при compose.https.yaml (это для оверрайда nginxproxy)
# ---------------------------------------------------------------------------
NGINX_PROXY_HOSTS=
