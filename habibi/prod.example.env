# Reference: https://github.com/frappe/frappe_docker/blob/main/docs/02-setup/04-env-variables.md
#
# ПРОД-КОНФИГ для сервера. На сервере копируется в .env рядом с compose.yaml.
# Строки, помеченные <<< ЗАПОЛНИТЬ, надо править руками перед первым запуском.

# ---------------------------------------------------------------------------
# Набор compose-файлов. Без этой переменной docker compose увидит только
# базовый compose.yaml и снесёт db/redis/proxy.
# ---------------------------------------------------------------------------
# Порядок значим:
#   - compose.platform.yaml    ПОСЛЕ compose.migrator.yaml, иначе у migrator
#                              останется linux/amd64;
#   - compose.backup-offsite.yaml ПОСЛЕ compose.backup-cron.yaml — сервис cron
#                              (ofelia) определён там, здесь только job.
#   - compose.wildcard-tls.yaml ПОСЛЕ compose.https.yaml — переопределяет
#                              резолвер Let's Encrypt на dns-01.
COMPOSE_FILE=compose.yaml:overrides/compose.mariadb.yaml:overrides/compose.redis.yaml:overrides/compose.https.yaml:overrides/compose.migrator.yaml:overrides/compose.backup-cron.yaml:habibi/overrides/compose.bindmounts.yaml:habibi/overrides/compose.platform.yaml:habibi/overrides/compose.backup-offsite.yaml:habibi/overrides/compose.wildcard-tls.yaml

# Архитектура хоста (оверрайд compose.platform.yaml). На Oracle Ampere и прочих
# ARM — linux/arm64, на обычных x86-серверах — linux/amd64. Должна совпадать
# с той, под которую собран образ: docker откажется запускать чужую.
PLATFORM=linux/arm64

# ---------------------------------------------------------------------------
# Раскладка данных на диске (оверрайд compose.bindmounts.yaml).
# Путь абсолютный. Каталоги sites/logs/mariadb/backups создать и выдать права
# ДО первого up -d — см. шапку compose.bindmounts.yaml.
# ---------------------------------------------------------------------------
DATA_ROOT=/u01/frappe

# Имя сайта. Обязано быть полным доменом и попадать под SITES_RULE, потому
# что FRAPPE_SITE_NAME_HEADER пустой и nginx резолвит сайт по Host запроса:
# имя каталога в sites/ должно совпадать с доменом символ в символ.
SITE_NAME=erp.habibi-erp.com

# ---------------------------------------------------------------------------
# Образ
# ---------------------------------------------------------------------------
ERPNEXT_VERSION=v16.30.0

# Вариант А, штатный: образ собран в CI и лежит в GHCR.
#
# CUSTOM_TAG держите ВЕРСИОННЫЙ (16-<hash>), а не скользящий 16. Тогда
# откат — это правка одной строки и docker compose up -d, без пересборки.
# Хеш берётся из вывода воркфлоу «Habibi image» → шаг «Итоговые теги».
# Со скользящим 16 вернуться к предыдущему коду невозможно: тег
# перезаписан, а bench migrate уже изменил схему базы.
CUSTOM_IMAGE=ghcr.io/dhi-partners/habibi
CUSTOM_TAG=16-CHANGE_ME          # <<< ЗАПОЛНИТЬ версионным тегом из CI
PULL_POLICY=always

# Вариант Б (сборка на сервере, habibi/build.sh): закомментировать вариант А.
# Сборка ест RAM и CPU боевой машины и занимает 15-30 минут. Применять,
# когда до registry не дотянуться.
#CUSTOM_IMAGE=habibi
#CUSTOM_TAG=16
#PULL_POLICY=never

RESTART_POLICY=unless-stopped

# ---------------------------------------------------------------------------
# База данных
# ---------------------------------------------------------------------------
# <<< ЗАПОЛНИТЬ: root-пароль MariaDB. Сгенерировать: openssl rand -base64 32
# Менять ПОСЛЕ создания сайта нельзя — пароль уйдёт в site_config.json.
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Only if you use docker secrets for the db password
DB_PASSWORD_SECRETS_FILE=

# Only if you use external database (пусто = контейнер db из compose.mariadb.yaml)
DB_HOST=
DB_PORT=

# Only if you use external Redis (пусто = контейнеры из compose.redis.yaml)
REDIS_CACHE=
REDIS_QUEUE=

# ---------------------------------------------------------------------------
# Gunicorn
# ---------------------------------------------------------------------------
GUNICORN_THREADS=4

# (2 x vCPU) + 1. Каждый воркер ~400 МБ — сверяйте с памятью сервера.
GUNICORN_WORKERS=9

GUNICORN_TIMEOUT=120

# ---------------------------------------------------------------------------
# Домен и TLS (оверрайд compose.https.yaml)
# ---------------------------------------------------------------------------
# DNS должен указывать на сервер ДО первого up -d, иначе Traefik закэширует
# неудачный ACME-запрос в томе cert-data. Для мультитенантности нужна одна
# wildcard-запись, дальше клиенты заводятся без правки DNS:
#   *.habibi-erp.com  A  <IP сервера>
BASE_DOMAIN=habibi-erp.com

# Регулярка вместо перечисления хостов — это и есть механизм мультитенантности:
# любой поддомен первого уровня уезжает на frontend, а какие из них реально
# существуют, решает наличие каталога в sites/. Матчит client1.habibi-erp.com,
# не матчит apex и a.b.habibi-erp.com (там нет ни сертификата, ни сайта).
# Точки экранированы; $ на конце docker compose отдаёт как есть.
#
# Апекс habibi-erp.com сюда намеренно не попадает — он занят лендингом.
SITES_RULE=HostRegexp(`^[a-z0-9-]+\.habibi-erp\.com$`)

# <<< ЗАПОЛНИТЬ: токен Cloudflare для dns-01 (оверрайд compose.wildcard-tls.yaml).
# My Profile -> API Tokens -> Create Token -> шаблон "Edit zone DNS",
# Zone Resources ограничить одной зоной habibi-erp.com. Права: Zone:DNS:Edit.
# Токен нужен только на выпуск и продление сертификата, раз в ~60 дней.
CF_DNS_API_TOKEN=

# <<< ЗАПОЛНИТЬ: реальный ящик, Let's Encrypt шлёт туда предупреждения об истечении
LETSENCRYPT_EMAIL=mail@example.com

# ---------------------------------------------------------------------------
# nginx внутри контейнера frontend
# ---------------------------------------------------------------------------
# Пусто = $host: сайт резолвится по домену из запроса.
# Требует, чтобы имя сайта в bench new-site совпадало с доменом из SITES_RULE.
FRAPPE_SITE_NAME_HEADER=

# Traefik слушает 80 — это обязательно для http-01 challenge Let's Encrypt.
HTTP_PUBLISH_PORT=80
HTTPS_PUBLISH_PORT=443

# Traefik стоит перед nginx, его IP — из docker-подсети, а не 127.0.0.1.
# Без этого в логах и в Frappe все клиенты будут с одним адресом.
UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12
UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
UPSTREAM_REAL_IP_RECURSIVE=on

PROXY_READ_TIMEOUT=120
CLIENT_MAX_BODY_SIZE=50m

# ---------------------------------------------------------------------------
# Бэкапы (overrides/compose.backup-cron.yaml)
# ---------------------------------------------------------------------------
# Локальные дампы в sites/<site>/private/backups.
BACKUP_CRONSTRING=@every 6h

# ---------------------------------------------------------------------------
# Вывоз бэкапов за пределы сервера (habibi/overrides/compose.backup-offsite.yaml)
# ---------------------------------------------------------------------------
# Обязателен, а не желателен: Frappe ежечасно подчищает старые дампы и
# оставляет последние backup_limit штук (System Settings, по умолчанию 3).
# Локально это ~18 часов истории, и лежит она на диске с базой.
#
# <<< ЗАПОЛНИТЬ: remote заводится на хосте через rclone config.
RCLONE_CONFIG_PATH=/home/ubuntu/.config/rclone/rclone.conf
RCLONE_REMOTE=habibi-backup:erp-ayntayba
OFFSITE_CRONSTRING=@every 12h

# ---------------------------------------------------------------------------
# Не используется при compose.https.yaml (это для оверрайда nginxproxy)
# ---------------------------------------------------------------------------
NGINX_PROXY_HOSTS=
